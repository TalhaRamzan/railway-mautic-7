# ---------------------------------------------------------------------------
# LOCAL docker compose only. On Railway these are set per service in the
# dashboard (see railway-template.md) and secrets come from ${{secret()}}.
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# MariaDB
DB_NAME=mautic
DB_USER=mautic
DB_PASSWORD=
DB_ROOT_PASSWORD=

# First-install admin account (only read on the very first boot)
ADMIN_EMAIL=
# at least 12 characters
ADMIN_PASSWORD=
ADMIN_USERNAME=admin

# Host ports for docker compose
WEB_PORT=8080
MAILPIT_PORT=8025

# Public URL of the web service (no trailing slash; match WEB_PORT locally)
SITE_URL=http://localhost:8080

# Email. Locally Mailpit catches everything (http://localhost:8025).
# On Railway use an HTTP API DSN, e.g.:
#   brevo+api://API_KEY@default
#   postmark+api://SERVER_TOKEN@default
#   resend+api://API_KEY@default
#   ses+api://ACCESS_KEY_ID:URL_ENCODED_SECRET@default?region=eu-west-1
#   sendgrid+api://API_KEY@default
#   mailgun+api://API_KEY:DOMAIN@default?region=us
MAILER_DSN=smtp://mailpit:1025
MAILER_FROM_EMAIL=
MAILER_FROM_NAME=

# PHP timezone for the containers
TZ=UTC
